{
    "name": "omnibus/colissimo",
    "type": "library",
    "description": "Omnibus Colissimo (La Poste): rates from configuration; labels, tracking and relay points to come.",
    "keywords": [
        "shipping",
        "omnibus",
        "colissimo",
        "la poste"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/omnibus": "^2.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Omnibus\\Colissimo\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnibus\\Colissimo\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
